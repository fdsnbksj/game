rules_version = '2';

// On the Spark plan there are no Cloud Functions, so these rules are the only
// server-side validation. They make cheating harder, not impossible.
//
// Anything without a rule here is denied. That closes everything left from earlier
// games: Neon Flap's leaderboards, item catalog and inventories (apart from reading your
// own old profile), the auto-battler's runs, puzzles and rankings, and this game's
// removed daily puzzle (dailySolves).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasExactly(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    function isValidName(name) {
      return name is string && name.size() >= 1 && name.size() <= 20;
    }

    function isRename() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && isValidName(request.resource.data.displayName);
    }

    function playerName(uid) {
      return get(/databases/$(database)/documents/players/$(uid)).data.displayName;
    }

    // Copies of src/nonogram/generate.ts; tests/unit/rulesSync.test.ts compares them.
    // The rules can't make a puzzle, so they check a solve's shape and `npm run audit`
    // checks it against the clues.
    function nonogramVersion() { return 1; }
    function sizeFor(level) {
      return level <= 3 ? 5 : (level <= 8 ? 6 : (level <= 15 ? 7 : (level <= 25 ? 8 : 10)));
    }
    function minSecondsBetweenLevels() { return 3; }

    // A solved grid: one string of 0s and 1s, row by row.
    function isGrid(grid, size) {
      return grid is string && grid.matches('[01]{' + string(size * size) + '}');
    }

    // Neon Flap profiles, read once so a returning player keeps their name.
    match /users/{uid} {
      allow read: if isOwner(uid);
    }

    // Auto-battler players still have runsStarted and lastRunStartAt; they're left as they are.
    match /players/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && hasExactly(request.resource.data, ['displayName', 'createdAt'])
        && isValidName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && isRename();
    }

    // The ladder starts with its first level.
    function isNewLadder(ladderId) {
      let ladder = request.resource.data;
      return ladderId == request.auth.uid + '_' + string(nonogramVersion())
        && hasExactly(ladder, ['uid', 'name', 'v', 'level', 'solutions', 'startedAt', 'lastAt'])
        && ladder.uid == request.auth.uid
        && ladder.name == playerName(request.auth.uid)
        && ladder.v == nonogramVersion()
        && ladder.level == 1
        && ladder.solutions is map
        && ladder.solutions.keys().hasOnly(['l1']) && ladder.solutions.keys().hasAll(['l1'])
        && isGrid(ladder.solutions.l1, sizeFor(1))
        && ladder.startedAt == request.time
        && ladder.lastAt == request.time;
    }

    // Each level after that: exactly the next one, with its grid added and none touched.
    function isNextLevel() {
      let before = resource.data;
      let after = request.resource.data;
      let key = 'l' + string(before.level + 1);
      let added = after.solutions.diff(before.solutions);
      return after.diff(before).affectedKeys().hasOnly(['level', 'solutions', 'name', 'lastAt'])
        && after.level == before.level + 1
        && added.affectedKeys().hasOnly([key]) && added.addedKeys().hasAll([key])
        && isGrid(after.solutions[key], sizeFor(after.level))
        && after.name == playerName(request.auth.uid)
        && after.lastAt == request.time
        && request.time > before.lastAt + duration.value(minSecondsBetweenLevels(), 's');
    }

    // Readable by everyone signed in, for the rankings.
    match /ladders/{ladderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isNewLadder(ladderId);
      allow update: if request.auth != null && request.auth.uid == resource.data.uid && isNextLevel();
    }

    // ---------- Avalon ----------
    // One room per game, played at one table with a phone each. There are no Cloud
    // Functions on Spark, so the host's phone deals the roles: the rules keep each role
    // private to its player and hold every write to its player, but they trust the host.
    // Quest cards are only ever counts, so no document says who played a fail.

    function room(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data;
    }

    function roomAfter(code) {
      return getAfter(/databases/$(database)/documents/rooms/$(code)).data;
    }

    function isMember(code) {
      return request.auth != null && request.auth.uid in room(code).playerIds;
    }

    function isPlaying(code) {
      return room(code).status == 'playing';
    }

    function avalonRoles() {
      return ['merlin', 'percival', 'servant', 'assassin', 'morgana', 'mordred', 'oberon', 'minion'];
    }

    function evilRoles() {
      return ['assassin', 'morgana', 'mordred', 'oberon', 'minion'];
    }

    function roleOf(code, uid) {
      return get(/databases/$(database)/documents/rooms/$(code)/secrets/$(uid)).data.role;
    }

    function isNewRoom(code) {
      let r = request.resource.data;
      return code.matches('[A-Z]{4}')
        && hasExactly(r, ['host', 'playerIds', 'names', 'status', 'optional', 'lady', 'createdAt'])
        && r.lady is bool
        && r.host == request.auth.uid
        && r.playerIds == [request.auth.uid]
        && r.names.keys().hasOnly([request.auth.uid]) && isValidName(r.names[request.auth.uid])
        && r.status == 'lobby'
        && r.optional is list && r.optional.hasOnly(['percival', 'morgana', 'mordred', 'oberon'])
        && r.createdAt == request.time;
    }

    function isJoin() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby'
        && !(request.auth.uid in before.playerIds)
        && before.playerIds.size() < 10
        && after.diff(before).affectedKeys().hasOnly(['playerIds', 'names'])
        && after.playerIds == before.playerIds.concat([request.auth.uid])
        && after.names.diff(before.names).affectedKeys().hasOnly([request.auth.uid])
        && isValidName(after.names[request.auth.uid]);
    }

    function isLeave() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby'
        && request.auth.uid in before.playerIds && request.auth.uid != before.host
        && after.diff(before).affectedKeys().hasOnly(['playerIds'])
        && after.playerIds == before.playerIds.removeAll([request.auth.uid]);
    }

    // Roles, the Lady of the Lake, and the seating: the same players, in the order they sit.
    function isHostSetup() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby' && request.auth.uid == before.host
        && after.diff(before).affectedKeys().hasOnly(['optional', 'lady', 'playerIds'])
        && after.optional is list && after.optional.hasOnly(['percival', 'morgana', 'mordred', 'oberon'])
        && after.get('lady', false) is bool
        && after.playerIds.size() == before.playerIds.size()
        && after.playerIds.toSet() == before.playerIds.toSet();
    }

    function isStart() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby' && request.auth.uid == before.host
        && after.diff(before).affectedKeys().hasOnly(['status', 'firstLeader', 'startedAt'])
        && after.status == 'playing'
        && before.playerIds.size() >= 5 && before.playerIds.size() <= 10
        && after.firstLeader is int && after.firstLeader >= 0 && after.firstLeader < before.playerIds.size()
        && after.startedAt == request.time;
    }

    // The game is over: evil won on quests or rejections (any player may say so; the app
    // works it out the same on every phone), or the assassin named someone.
    function isFinish(code) {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'playing' && request.auth.uid in before.playerIds
        && after.status == 'done'
        && after.endedAt == request.time
        && (
          (after.diff(before).affectedKeys().hasOnly(['status', 'endedAt']))
          || (after.diff(before).affectedKeys().hasOnly(['status', 'endedAt', 'assassinated'])
            && roleOf(code, request.auth.uid) == 'assassin'
            && after.assassinated in before.playerIds)
        );
    }

    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isNewRoom(code);
      allow update: if request.auth != null && (isJoin() || isLeave() || isHostSetup() || isStart() || isFinish(code));

      // Each player's role and night knowledge, written by the host in the batch that
      // starts the game, and readable only by that player until the game is over.
      match /secrets/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || room(code).status == 'done');
        allow create: if request.auth != null
          && room(code).host == request.auth.uid
          && room(code).status == 'lobby' && roomAfter(code).status == 'playing'
          && uid in room(code).playerIds
          && hasExactly(request.resource.data, ['role', 'sees'])
          && request.resource.data.role in avalonRoles()
          && request.resource.data.sees is list;
      }

      // The leader's team for one attempt at one quest: `{quest}-{attempt}`.
      match /proposals/{id} {
        allow read: if isMember(code);
        allow create: if isMember(code) && isPlaying(code)
          && hasExactly(request.resource.data, ['quest', 'attempt', 'leader', 'team'])
          && id == string(request.resource.data.quest) + '-' + string(request.resource.data.attempt)
          && request.resource.data.quest is int && request.resource.data.quest >= 0 && request.resource.data.quest < 5
          && request.resource.data.attempt is int && request.resource.data.attempt >= 0 && request.resource.data.attempt < 5
          && request.resource.data.leader == request.auth.uid
          && request.resource.data.team is list
          && request.resource.data.team.size() >= 2 && request.resource.data.team.size() <= 5
          && request.resource.data.team.hasOnly(room(code).playerIds)
          && request.resource.data.team.toSet().size() == request.resource.data.team.size();
      }

      // One vote per player per team: `{quest}-{attempt}-{uid}`. Team votes are public in Avalon.
      match /votes/{id} {
        allow read: if isMember(code);
        allow create: if isMember(code) && isPlaying(code)
          && hasExactly(request.resource.data, ['quest', 'attempt', 'uid', 'approve'])
          && request.resource.data.uid == request.auth.uid
          && id == string(request.resource.data.quest) + '-' + string(request.resource.data.attempt) + '-' + request.auth.uid
          && request.resource.data.approve is bool
          && exists(/databases/$(database)/documents/rooms/$(code)/proposals/$(string(request.resource.data.quest) + '-' + string(request.resource.data.attempt)));
      }

      // A quest's cards as counts only. Playing a card writes, together, a marker saying
      // the player has played (with no choice in it) and a tally going up by one.
      match /quests/{quest} {
        allow read: if isMember(code);
        allow create: if isMember(code) && isPlaying(code)
          && hasExactly(request.resource.data, ['quest', 'attempt', 'successes', 'fails'])
          && string(request.resource.data.quest) == quest
          && request.resource.data.attempt is int
          && ((request.resource.data.successes == 1 && request.resource.data.fails == 0)
            || (request.resource.data.successes == 0 && request.resource.data.fails == 1))
          && isCardPlay(code, quest, request.resource.data.attempt, request.resource.data.fails == 1);
        allow update: if isMember(code) && isPlaying(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['successes', 'fails'])
          && ((request.resource.data.successes == resource.data.successes + 1 && request.resource.data.fails == resource.data.fails)
            || (request.resource.data.fails == resource.data.fails + 1 && request.resource.data.successes == resource.data.successes))
          && isCardPlay(code, quest, resource.data.attempt, request.resource.data.fails == resource.data.fails + 1);

        // Who has played: nothing about what.
        match /cards/{uid} {
          allow read: if isMember(code);
          allow create: if isMember(code) && isPlaying(code)
            && uid == request.auth.uid
            && request.resource.data.keys().size() == 0
            && playedAfter(code, quest) == playedBefore(code, quest) + 1;
        }
      }

      // Cards counted on a quest, before and after this write: a marker must come with one more.
      function playedBefore(code, quest) {
        let path = /databases/$(database)/documents/rooms/$(code)/quests/$(quest);
        return exists(path) ? get(path).data.successes + get(path).data.fails : 0;
      }

      function playedAfter(code, quest) {
        let path = /databases/$(database)/documents/rooms/$(code)/quests/$(quest);
        return existsAfter(path) ? getAfter(path).data.successes + getAfter(path).data.fails : 0;
      }

      // ---------- The Lady of the Lake ----------
      // After quests 2, 3 and 4 (`after` = 1, 2, 3), whoever holds her examines another
      // player's loyalty and passes her on. She starts to the right of the first leader,
      // and never goes back to anyone who has held her.

      function ladyPick(code, after) {
        return get(/databases/$(database)/documents/rooms/$(code)/lady/$(string(after))).data;
      }

      function firstHolder(code) {
        let r = room(code);
        return r.playerIds[(r.firstLeader + r.playerIds.size() - 1) % r.playerIds.size()];
      }

      // Written without `? :`: the emulator crashes on these conditionals rather than denying.
      function isLadyHolder(code, after) {
        return (after == 1 && request.auth.uid == firstHolder(code))
          || (after > 1 && request.auth.uid == ladyPick(code, after - 1).target);
      }

      function wasLadyHolder(code, after, uid) {
        return uid == firstHolder(code)
          || (after > 1 && uid == ladyPick(code, 1).target)
          || (after > 2 && uid == ladyPick(code, 2).target);
      }

      function isCardPlay(code, quest, attempt, fail) {
        let marker = /databases/$(database)/documents/rooms/$(code)/quests/$(quest)/cards/$(request.auth.uid);
        let proposal = get(/databases/$(database)/documents/rooms/$(code)/proposals/$(quest + '-' + string(attempt))).data;
        return !exists(marker) && existsAfter(marker)
          && request.auth.uid in proposal.team
          && (!fail || roleOf(code, request.auth.uid) in evilRoles());
      }

      // Who the holder examined: public, as at a real table. `{after}` is 1, 2 or 3.
      match /lady/{after} {
        allow read: if isMember(code);
        allow create: if isMember(code) && isPlaying(code)
          && room(code).get('lady', false) == true
          && after in ['1', '2', '3']
          && hasExactly(request.resource.data, ['quest', 'holder', 'target'])
          && request.resource.data.quest == int(after)
          && request.resource.data.holder == request.auth.uid
          && isLadyHolder(code, int(after))
          && request.resource.data.target in room(code).playerIds
          && !wasLadyHolder(code, int(after), request.resource.data.target);
      }

      // What the holder learns. The examined player's own phone writes it, and the rules
      // check it against their role, so no one can lie; only the holder can read it.
      match /ladyResults/{after} {
        allow read: if request.auth != null
          && (request.auth.uid == ladyPick(code, int(after)).holder || room(code).status == 'done');
        allow create: if isMember(code) && isPlaying(code)
          && request.auth.uid == ladyPick(code, int(after)).target
          && hasExactly(request.resource.data, ['evil'])
          && request.resource.data.evil == (roleOf(code, request.auth.uid) in evilRoles());
      }
    }
  }
}
