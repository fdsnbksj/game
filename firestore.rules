rules_version = '2';

// On the Spark plan there are no Cloud Functions, so these rules are the only
// server-side validation. They make cheating harder, not impossible.
//
// Anything without a rule here is denied. That closes everything left from earlier
// games: Neon Flap's leaderboards, item catalog and inventories (apart from reading your
// own old profile), the auto-battler's runs, puzzles and rankings, and this game's
// removed daily puzzle (dailySolves).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasExactly(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    function isValidName(name) {
      return name is string && name.size() >= 1 && name.size() <= 20;
    }

    function isRename() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && isValidName(request.resource.data.displayName);
    }

    function playerName(uid) {
      return get(/databases/$(database)/documents/players/$(uid)).data.displayName;
    }

    // Copies of src/nonogram/generate.ts; tests/unit/rulesSync.test.ts compares them.
    // The rules can't make a puzzle, so they check a solve's shape and `npm run audit`
    // checks it against the clues.
    function nonogramVersion() { return 1; }
    function sizeFor(level) {
      return level <= 3 ? 5 : (level <= 8 ? 6 : (level <= 15 ? 7 : (level <= 25 ? 8 : 10)));
    }
    function minSecondsBetweenLevels() { return 3; }

    // A solved grid: one string of 0s and 1s, row by row.
    function isGrid(grid, size) {
      return grid is string && grid.matches('[01]{' + string(size * size) + '}');
    }

    // Neon Flap profiles, read once so a returning player keeps their name.
    match /users/{uid} {
      allow read: if isOwner(uid);
    }

    // Auto-battler players still have runsStarted and lastRunStartAt; they're left as they are.
    match /players/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && hasExactly(request.resource.data, ['displayName', 'createdAt'])
        && isValidName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && isRename();
    }

    // The ladder starts with its first level.
    function isNewLadder(ladderId) {
      let ladder = request.resource.data;
      return ladderId == request.auth.uid + '_' + string(nonogramVersion())
        && hasExactly(ladder, ['uid', 'name', 'v', 'level', 'solutions', 'startedAt', 'lastAt'])
        && ladder.uid == request.auth.uid
        && ladder.name == playerName(request.auth.uid)
        && ladder.v == nonogramVersion()
        && ladder.level == 1
        && ladder.solutions is map
        && ladder.solutions.keys().hasOnly(['l1']) && ladder.solutions.keys().hasAll(['l1'])
        && isGrid(ladder.solutions.l1, sizeFor(1))
        && ladder.startedAt == request.time
        && ladder.lastAt == request.time;
    }

    // Each level after that: exactly the next one, with its grid added and none touched.
    function isNextLevel() {
      let before = resource.data;
      let after = request.resource.data;
      let key = 'l' + string(before.level + 1);
      let added = after.solutions.diff(before.solutions);
      return after.diff(before).affectedKeys().hasOnly(['level', 'solutions', 'name', 'lastAt'])
        && after.level == before.level + 1
        && added.affectedKeys().hasOnly([key]) && added.addedKeys().hasAll([key])
        && isGrid(after.solutions[key], sizeFor(after.level))
        && after.name == playerName(request.auth.uid)
        && after.lastAt == request.time
        && request.time > before.lastAt + duration.value(minSecondsBetweenLevels(), 's');
    }

    // Readable by everyone signed in, for the rankings.
    match /ladders/{ladderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isNewLadder(ladderId);
      allow update: if request.auth != null && request.auth.uid == resource.data.uid && isNextLevel();
    }

    // ---------- Avalon ----------
    // One room per game, played at one table with a phone each. There are no Cloud
    // Functions on Spark, so the host's phone deals the roles: the rules keep each role
    // private to its player and hold every write to its player, but they trust the host.
    // Quest cards are only ever counts, so no document says who played a fail.

    function room(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data;
    }

    function roomAfter(code) {
      return getAfter(/databases/$(database)/documents/rooms/$(code)).data;
    }

    function isMember(code) {
      return request.auth != null && request.auth.uid in room(code).playerIds;
    }

    function isPlaying(code) {
      return room(code).status == 'playing';
    }

    function avalonRoles() {
      return ['merlin', 'percival', 'servant', 'assassin', 'morgana', 'mordred', 'oberon', 'minion'];
    }

    function evilRoles() {
      return ['assassin', 'morgana', 'mordred', 'oberon', 'minion'];
    }

    function roleOf(code, uid) {
      return get(/databases/$(database)/documents/rooms/$(code)/secrets/$(uid)).data.role;
    }

    function isNewRoom(code) {
      let r = request.resource.data;
      return code.matches('[A-Z]{4}')
        && hasExactly(r, ['host', 'playerIds', 'names', 'status', 'optional', 'lady', 'createdAt'])
        && r.lady is bool
        && r.host == request.auth.uid
        && r.playerIds == [request.auth.uid]
        && r.names.keys().hasOnly([request.auth.uid]) && isValidName(r.names[request.auth.uid])
        && r.status == 'lobby'
        && r.optional is list && r.optional.hasOnly(['percival', 'morgana', 'mordred', 'oberon'])
        && r.createdAt == request.time;
    }

    function isJoin() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby'
        && !(request.auth.uid in before.playerIds)
        && before.playerIds.size() < 10
        && after.diff(before).affectedKeys().hasOnly(['playerIds', 'names'])
        && after.playerIds == before.playerIds.concat([request.auth.uid])
        && after.names.diff(before.names).affectedKeys().hasOnly([request.auth.uid])
        && isValidName(after.names[request.auth.uid]);
    }

    function isLeave() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby'
        && request.auth.uid in before.playerIds && request.auth.uid != before.host
        && after.diff(before).affectedKeys().hasOnly(['playerIds'])
        && after.playerIds == before.playerIds.removeAll([request.auth.uid]);
    }

    // Roles, the Lady of the Lake, and the seating: the same players, in the order they sit.
    function isHostSetup() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby' && request.auth.uid == before.host
        && after.diff(before).affectedKeys().hasOnly(['optional', 'lady', 'playerIds'])
        && after.optional is list && after.optional.hasOnly(['percival', 'morgana', 'mordred', 'oberon'])
        && after.get('lady', false) is bool
        && after.playerIds.size() == before.playerIds.size()
        && after.playerIds.toSet() == before.playerIds.toSet();
    }

    function isStart() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby' && request.auth.uid == before.host
        && after.diff(before).affectedKeys().hasOnly(['status', 'firstLeader', 'startedAt'])
        && after.status == 'playing'
        && before.playerIds.size() >= 5 && before.playerIds.size() <= 10
        && after.firstLeader is int && after.firstLeader >= 0 && after.firstLeader < before.playerIds.size()
        && after.startedAt == request.time;
    }

    // The game is over: evil won on quests or rejections (any player may say so; the app
    // works it out the same on every phone), or the assassin named someone.
    function isFinish(code) {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'playing' && request.auth.uid in before.playerIds
        && after.status == 'done'
        && after.endedAt == request.time
        && (
          (after.diff(before).affectedKeys().hasOnly(['status', 'endedAt']))
          || (after.diff(before).affectedKeys().hasOnly(['status', 'endedAt', 'assassinated'])
            && roleOf(code, request.auth.uid) == 'assassin'
            && after.assassinated in before.playerIds)
        );
    }

    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isNewRoom(code);
      allow update: if request.auth != null && (isJoin() || isLeave() || isHostSetup() || isStart() || isFinish(code));

      // Each player's role and night knowledge, written by the host in the batch that
      // starts the game, and readable only by that player until the game is over.
      match /secrets/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || room(code).status == 'done');
        allow create: if request.auth != null
          && room(code).host == request.auth.uid
          && room(code).status == 'lobby' && roomAfter(code).status == 'playing'
          && uid in room(code).playerIds
          && hasExactly(request.resource.data, ['role', 'sees'])
          && request.resource.data.role in avalonRoles()
          && request.resource.data.sees is list;
      }

      // The leader's team for one attempt at one quest: `{quest}-{attempt}`.
      match /proposals/{id} {
        allow read: if isMember(code);
        allow create: if isMember(code) && isPlaying(code)
          && hasExactly(request.resource.data, ['quest', 'attempt', 'leader', 'team'])
          && id == string(request.resource.data.quest) + '-' + string(request.resource.data.attempt)
          && request.resource.data.quest is int && request.resource.data.quest >= 0 && request.resource.data.quest < 5
          && request.resource.data.attempt is int && request.resource.data.attempt >= 0 && request.resource.data.attempt < 5
          && request.resource.data.leader == request.auth.uid
          && request.resource.data.team is list
          && request.resource.data.team.size() >= 2 && request.resource.data.team.size() <= 5
          && request.resource.data.team.hasOnly(room(code).playerIds)
          && request.resource.data.team.toSet().size() == request.resource.data.team.size();
      }

      // One vote per player per team: `{quest}-{attempt}-{uid}`. Team votes are public in Avalon.
      match /votes/{id} {
        allow read: if isMember(code);
        allow create: if isMember(code) && isPlaying(code)
          && hasExactly(request.resource.data, ['quest', 'attempt', 'uid', 'approve'])
          && request.resource.data.uid == request.auth.uid
          && id == string(request.resource.data.quest) + '-' + string(request.resource.data.attempt) + '-' + request.auth.uid
          && request.resource.data.approve is bool
          && exists(/databases/$(database)/documents/rooms/$(code)/proposals/$(string(request.resource.data.quest) + '-' + string(request.resource.data.attempt)));
      }

      // A quest's cards as counts only. Playing a card writes, together, a marker saying
      // the player has played (with no choice in it) and a tally going up by one.
      match /quests/{quest} {
        allow read: if isMember(code);
        allow create: if isMember(code) && isPlaying(code)
          && hasExactly(request.resource.data, ['quest', 'attempt', 'successes', 'fails'])
          && string(request.resource.data.quest) == quest
          && request.resource.data.attempt is int
          && ((request.resource.data.successes == 1 && request.resource.data.fails == 0)
            || (request.resource.data.successes == 0 && request.resource.data.fails == 1))
          && isCardPlay(code, quest, request.resource.data.attempt, request.resource.data.fails == 1);
        allow update: if isMember(code) && isPlaying(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['successes', 'fails'])
          && ((request.resource.data.successes == resource.data.successes + 1 && request.resource.data.fails == resource.data.fails)
            || (request.resource.data.fails == resource.data.fails + 1 && request.resource.data.successes == resource.data.successes))
          && isCardPlay(code, quest, resource.data.attempt, request.resource.data.fails == resource.data.fails + 1);

        // Who has played: nothing about what.
        match /cards/{uid} {
          allow read: if isMember(code);
          allow create: if isMember(code) && isPlaying(code)
            && uid == request.auth.uid
            && request.resource.data.keys().size() == 0
            && playedAfter(code, quest) == playedBefore(code, quest) + 1;
        }
      }

      // Cards counted on a quest, before and after this write: a marker must come with one more.
      function playedBefore(code, quest) {
        let path = /databases/$(database)/documents/rooms/$(code)/quests/$(quest);
        return exists(path) ? get(path).data.successes + get(path).data.fails : 0;
      }

      function playedAfter(code, quest) {
        let path = /databases/$(database)/documents/rooms/$(code)/quests/$(quest);
        return existsAfter(path) ? getAfter(path).data.successes + getAfter(path).data.fails : 0;
      }

      // ---------- The Lady of the Lake ----------
      // After quests 2, 3 and 4 (`after` = 1, 2, 3), whoever holds her examines another
      // player's loyalty and passes her on. She starts to the right of the first leader,
      // and never goes back to anyone who has held her.

      function ladyPick(code, after) {
        return get(/databases/$(database)/documents/rooms/$(code)/lady/$(string(after))).data;
      }

      function firstHolder(code) {
        let r = room(code);
        return r.playerIds[(r.firstLeader + r.playerIds.size() - 1) % r.playerIds.size()];
      }

      // Written without `? :`: the emulator crashes on these conditionals rather than denying.
      function isLadyHolder(code, after) {
        return (after == 1 && request.auth.uid == firstHolder(code))
          || (after > 1 && request.auth.uid == ladyPick(code, after - 1).target);
      }

      function wasLadyHolder(code, after, uid) {
        return uid == firstHolder(code)
          || (after > 1 && uid == ladyPick(code, 1).target)
          || (after > 2 && uid == ladyPick(code, 2).target);
      }

      function isCardPlay(code, quest, attempt, fail) {
        let marker = /databases/$(database)/documents/rooms/$(code)/quests/$(quest)/cards/$(request.auth.uid);
        let proposal = get(/databases/$(database)/documents/rooms/$(code)/proposals/$(quest + '-' + string(attempt))).data;
        return !exists(marker) && existsAfter(marker)
          && request.auth.uid in proposal.team
          && (!fail || roleOf(code, request.auth.uid) in evilRoles());
      }

      // Who the holder examined: public, as at a real table. `{after}` is 1, 2 or 3.
      match /lady/{after} {
        allow read: if isMember(code);
        allow create: if isMember(code) && isPlaying(code)
          && room(code).get('lady', false) == true
          && after in ['1', '2', '3']
          && hasExactly(request.resource.data, ['quest', 'holder', 'target'])
          && request.resource.data.quest == int(after)
          && request.resource.data.holder == request.auth.uid
          && isLadyHolder(code, int(after))
          && request.resource.data.target in room(code).playerIds
          && !wasLadyHolder(code, int(after), request.resource.data.target);
      }

      // What the holder learns. The examined player's own phone writes it, and the rules
      // check it against their role, so no one can lie; only the holder can read it.
      match /ladyResults/{after} {
        allow read: if request.auth != null
          && (request.auth.uid == ladyPick(code, int(after)).holder || room(code).status == 'done');
        allow create: if isMember(code) && isPlaying(code)
          && request.auth.uid == ladyPick(code, int(after)).target
          && hasExactly(request.resource.data, ['evil'])
          && request.resource.data.evil == (roleOf(code, request.auth.uid) in evilRoles());
      }
    }

    // ---------- Rival Wonders ----------
    // Two players; the seed (written by the host at the start) decides the layouts, and
    // each move is a document appended in order by the player making it. The rules can't
    // judge a move: both phones replay the same moves and skip any the game refuses.

    function duel(code) {
      return get(/databases/$(database)/documents/duels/$(code)).data;
    }

    function isDuelPlayer(code) {
      return request.auth != null && request.auth.uid in duel(code).playerIds;
    }

    match /duels/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && code.matches('[A-Z]{4}')
        && hasExactly(request.resource.data, ['host', 'playerIds', 'names', 'status', 'createdAt'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.playerIds == [request.auth.uid]
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && isValidName(request.resource.data.names[request.auth.uid])
        && request.resource.data.status == 'lobby'
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && (isDuelJoin() || isDuelStart() || isDuelFinish());

      match /moves/{n} {
        allow read: if isDuelPlayer(code);
        allow create: if isDuelPlayer(code)
          && duel(code).status == 'playing'
          && hasExactly(request.resource.data, ['n', 'by', 'move'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.n is int && request.resource.data.n >= 0
          && string(request.resource.data.n) == n
          && (request.resource.data.n == 0
            || exists(/databases/$(database)/documents/duels/$(code)/moves/$(string(request.resource.data.n - 1))))
          && request.resource.data.move is map;
      }
    }

    function isDuelJoin() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby'
        && before.playerIds.size() == 1
        && !(request.auth.uid in before.playerIds)
        && after.diff(before).affectedKeys().hasOnly(['playerIds', 'names'])
        && after.playerIds == before.playerIds.concat([request.auth.uid])
        && after.names.diff(before.names).affectedKeys().hasOnly([request.auth.uid])
        && isValidName(after.names[request.auth.uid]);
    }

    function isDuelStart() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby' && request.auth.uid == before.host
        && before.playerIds.size() == 2
        && after.diff(before).affectedKeys().hasOnly(['status', 'seed', 'startedAt'])
        && after.status == 'playing'
        && after.seed is string && after.seed.size() >= 6 && after.seed.size() <= 40
        && after.startedAt == request.time;
    }

    function isDuelFinish() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'playing' && request.auth.uid in before.playerIds
        && after.diff(before).affectedKeys().hasOnly(['status', 'endedAt'])
        && after.status == 'done'
        && after.endedAt == request.time;
    }

    // ---------- Hero Gambit ----------
    // heroes/{uid} is a player's hero: bot levels cleared and the skill tree. The tree can't
    // hold more points than those levels give (a copy of pointsFor in src/games/hero/stats.ts;
    // tests/unit/rulesSync.test.ts compares them), and `cleared` rises by at most one a write.
    // The rules can't watch a fight, so a tampered phone could still claim a win.

    function heroPoints(cleared) {
      return cleared + 2 * math.floor(cleared / 5);
    }
    function heroBotCount() { return 20; }

    function isHeroNode(v) {
      return v is int && v >= 0 && v <= 10;
    }

    function isHeroTree(t, cleared) {
      return t is map
        && hasExactly(t, ['stopwatch', 'roulette', 'poker', 'hp', 'def', 'crit', 'critDmg'])
        && isHeroNode(t.stopwatch) && t.stopwatch >= 1
        && isHeroNode(t.roulette) && isHeroNode(t.poker)
        && isHeroNode(t.hp) && isHeroNode(t.def) && isHeroNode(t.crit) && isHeroNode(t.critDmg)
        && t.stopwatch + t.roulette + t.poker + t.hp + t.def + t.crit + t.critDmg - 1 <= heroPoints(cleared);
    }

    // A hero's look: indexes into the catalogues in src/games/hero/look.ts (their sizes are
    // copied here; tests/unit/rulesSync.test.ts compares them).
    function isLookPart(v, size) {
      return v is int && v >= 0 && v < size;
    }

    function isLook(l) {
      return l is map
        && hasExactly(l, ['skin', 'face', 'hair', 'hairColour', 'hat', 'shirt', 'shirtColour', 'pants', 'pantsColour', 'extra'])
        && isLookPart(l.skin, 6) && isLookPart(l.face, 8) && isLookPart(l.hair, 9) && isLookPart(l.hairColour, 12)
        && isLookPart(l.hat, 12) && isLookPart(l.shirt, 4) && isLookPart(l.shirtColour, 12)
        && isLookPart(l.pants, 2) && isLookPart(l.pantsColour, 12) && isLookPart(l.extra, 7);
    }

    // Everything Summon can give (a copy of ALL_ITEMS in src/games/hero/gacha.ts).
    function summonItems() {
      return [
        'hat:crown', 'hat:tophat', 'hat:viking', 'hat:halo', 'hat:catears', 'hat:propeller', 'hat:wizard', 'hat:chef',
        'shirt:armour',
        'extra:sunglasses', 'extra:scarf', 'extra:cape', 'extra:wings', 'extra:headphones', 'extra:sword',
        'costume:trippi', 'costume:ambalabu', 'costume:frigo', 'costume:glorbo', 'costume:burbaloni', 'costume:capybara',
        'costume:cappuccina', 'costume:patapim', 'costume:bananini', 'costume:larila', 'costume:assassino', 'costume:saturnita',
        'costume:tungtung', 'costume:tralalero', 'costume:bombardiro'
      ];
    }

    function wardrobe(uid) {
      return get(/databases/$(database)/documents/wardrobes/$(uid)).data;
    }

    // wardrobes/{uid}: what you've summoned, your gems and what you wear. Summon runs on
    // the phone (no Cloud Functions on Spark), so the rules only check the shape: a
    // tampered phone could give itself gems or costumes, whose bonus is small and capped.
    function isWardrobe(w) {
      return hasExactly(w, ['look', 'costume', 'owned', 'gems', 'pity', 'lastFree', 'updatedAt'])
        && isLook(w.look)
        && w.owned is list && w.owned.size() <= 60 && w.owned.hasOnly(summonItems())
        && w.gems is int && w.gems >= 0 && w.gems <= 10000000
        && w.pity is int && w.pity >= 0 && w.pity < 50
        && w.lastFree is string && w.lastFree.size() <= 10
        && (w.costume == null || (w.costume is string && ('costume:' + w.costume) in w.owned))
        && w.updatedAt == request.time;
    }

    match /wardrobes/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isWardrobe(request.resource.data);
    }

    // The hero doc may carry the look and the costume worn, which must be one summoned.
    function isHeroDoc(data, uid) {
      return data.keys().hasAll(['cleared', 'tree', 'updatedAt'])
        && data.keys().hasOnly(['cleared', 'tree', 'updatedAt', 'look', 'costume'])
        && data.cleared is int && data.cleared >= 0 && data.cleared <= heroBotCount()
        && isHeroTree(data.tree, data.cleared)
        && (!('look' in data) || isLook(data.look))
        && (!('costume' in data) || data.costume == null
          || (data.costume is string && ('costume:' + data.costume) in wardrobe(uid).owned))
        && data.updatedAt == request.time;
    }

    match /heroes/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isHeroDoc(request.resource.data, uid) && request.resource.data.cleared <= 1;
      allow update: if isOwner(uid) && isHeroDoc(request.resource.data, uid)
        && request.resource.data.cleared >= resource.data.cleared
        && request.resource.data.cleared <= resource.data.cleared + 1;
    }

    // A fight between two phones, built like Rival Wonders' rooms. Each player brings the
    // tree on their own hero doc, nothing else.
    function heroTree(uid) {
      return get(/databases/$(database)/documents/heroes/$(uid)).data.tree;
    }

    function hero(uid) {
      return get(/databases/$(database)/documents/heroes/$(uid)).data;
    }

    // What a player wears into a fight: the same as their hero doc.
    function heroAppearance(uid) {
      return { 'look': hero(uid).get('look', null), 'costume': hero(uid).get('costume', null) };
    }

    function heroRoom(code) {
      return get(/databases/$(database)/documents/heroDuels/$(code)).data;
    }

    function isHeroRoomPlayer(code) {
      return request.auth != null && request.auth.uid in heroRoom(code).playerIds;
    }

    match /heroDuels/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && code.matches('[A-Z]{4}')
        && request.resource.data.keys().hasAll(['host', 'playerIds', 'names', 'fighters', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['host', 'playerIds', 'names', 'fighters', 'looks', 'status', 'createdAt'])
        && (!('looks' in request.resource.data)
          || (request.resource.data.looks.keys().hasOnly([request.auth.uid])
            && request.resource.data.looks[request.auth.uid] == heroAppearance(request.auth.uid)))
        && request.resource.data.host == request.auth.uid
        && request.resource.data.playerIds == [request.auth.uid]
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && isValidName(request.resource.data.names[request.auth.uid])
        && request.resource.data.fighters.keys().hasOnly([request.auth.uid])
        && request.resource.data.fighters[request.auth.uid] == heroTree(request.auth.uid)
        && request.resource.data.status == 'lobby'
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && (isHeroJoin() || isHeroStart() || isHeroFinish());

      match /moves/{n} {
        allow read: if isHeroRoomPlayer(code);
        allow create: if isHeroRoomPlayer(code)
          && heroRoom(code).status == 'playing'
          && hasExactly(request.resource.data, ['n', 'by', 'move'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.n is int && request.resource.data.n >= 0
          && string(request.resource.data.n) == n
          && (request.resource.data.n == 0
            || exists(/databases/$(database)/documents/heroDuels/$(code)/moves/$(string(request.resource.data.n - 1))))
          && request.resource.data.move is map;
      }
    }

    function isHeroJoin() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby'
        && before.playerIds.size() == 1
        && !(request.auth.uid in before.playerIds)
        && after.diff(before).affectedKeys().hasOnly(['playerIds', 'names', 'fighters', 'looks'])
        && (!('looks' in after)
          || (after.looks.diff(before.get('looks', {})).affectedKeys().hasOnly([request.auth.uid])
            && after.looks.get(request.auth.uid, null) == heroAppearance(request.auth.uid)))
        && after.playerIds == before.playerIds.concat([request.auth.uid])
        && after.names.diff(before.names).affectedKeys().hasOnly([request.auth.uid])
        && isValidName(after.names[request.auth.uid])
        && after.fighters.diff(before.fighters).affectedKeys().hasOnly([request.auth.uid])
        && after.fighters[request.auth.uid] == heroTree(request.auth.uid);
    }

    function isHeroStart() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby' && request.auth.uid == before.host
        && before.playerIds.size() == 2
        && after.diff(before).affectedKeys().hasOnly(['status', 'seed', 'startedAt'])
        && after.status == 'playing'
        && after.seed is string && after.seed.size() >= 6 && after.seed.size() <= 40
        && after.startedAt == request.time;
    }

    function isHeroFinish() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'playing' && request.auth.uid in before.playerIds
        && after.diff(before).affectedKeys().hasOnly(['status', 'endedAt'])
        && after.status == 'done'
        && after.endedAt == request.time;
    }

    // ---------- Hero Gambit arena ----------
    // Async PvP: arena/{uid} is a hero others fight (played by the bot brain on the
    // attacker's phone), so anyone signed in may read it. Only its owner writes it: to join
    // once past the first boss, to keep its tree and name in step with their hero and
    // player, or to record one result at a time. Copies of src/games/hero/arena.ts;
    // tests/unit/rulesSync.test.ts compares them. A tampered phone could still claim a
    // win it didn't earn, but only up to arenaMaxDelta() points, once every 10 s.

    function arenaUnlock() { return 5; }
    function arenaMaxDelta() { return 35; }
    function arenaMinGain() { return 5; }

    function isArenaJoin(uid) {
      let a = request.resource.data;
      return a.keys().hasAll(['name', 'tree', 'rating', 'wins', 'losses', 'lastFightAt'])
        && a.keys().hasOnly(['name', 'tree', 'look', 'costume', 'rating', 'wins', 'losses', 'lastFightAt'])
        && hero(uid).cleared >= arenaUnlock()
        && a.get('look', null) == hero(uid).get('look', null)
        && a.get('costume', null) == hero(uid).get('costume', null)
        && a.tree == heroTree(uid)
        && a.name == playerName(uid)
        && a.rating == 1000 && a.wins == 0 && a.losses == 0
        && a.lastFightAt == request.time;
    }

    function isArenaRefresh(uid) {
      let after = request.resource.data;
      return after.diff(resource.data).affectedKeys().hasOnly(['tree', 'name', 'look', 'costume'])
        && after.tree == heroTree(uid)
        && after.get('look', null) == hero(uid).get('look', null)
        && after.get('costume', null) == hero(uid).get('costume', null)
        && after.name == playerName(uid);
    }

    function isArenaWin(before, after) {
      return after.wins == before.wins + 1 && after.losses == before.losses
        && after.rating - before.rating >= arenaMinGain()
        && after.rating - before.rating <= arenaMaxDelta();
    }

    function isArenaLoss(before, after) {
      return after.losses == before.losses + 1 && after.wins == before.wins
        && before.rating - after.rating >= arenaMinGain()
        && before.rating - after.rating <= arenaMaxDelta();
    }

    function isArenaResult() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['rating', 'wins', 'losses', 'lastFightAt'])
        && after.rating is int
        && after.lastFightAt == request.time
        && request.time >= before.lastFightAt + duration.value(10, 's')
        && (isArenaWin(before, after) || isArenaLoss(before, after));
    }

    match /arena/{uid} {
      allow read: if request.auth != null;
      allow create: if isOwner(uid) && isArenaJoin(uid);
      allow update: if isOwner(uid) && (isArenaRefresh(uid) || isArenaResult());
    }

    // ---------- Ancient Wonders ----------
    // 3–7 seats, some of them bots (`bot:1`…`bot:6`) that the host's phone plays. The seed
    // decides the boards and the hands; each pick is a move appended in order. The rules
    // can't judge a pick: every phone replays the moves and skips any the game refuses.

    function botIds() {
      return ['bot:1', 'bot:2', 'bot:3', 'bot:4', 'bot:5', 'bot:6'];
    }

    function wondersRoom(code) {
      return get(/databases/$(database)/documents/wonders/$(code)).data;
    }

    function isWondersPlayer(code) {
      return request.auth != null && request.auth.uid in wondersRoom(code).seats;
    }

    match /wonders/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && code.matches('[A-Z]{4}')
        && hasExactly(request.resource.data, ['host', 'seats', 'names', 'status', 'sides', 'createdAt'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.seats == [request.auth.uid]
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && isValidName(request.resource.data.names[request.auth.uid])
        && request.resource.data.status == 'lobby'
        && request.resource.data.sides in ['A', 'B', 'random']
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && (isWondersJoin() || isWondersLeave() || isWondersSetup() || isWondersStart() || isWondersFinish());

      match /moves/{n} {
        allow read: if isWondersPlayer(code);
        allow create: if isWondersPlayer(code)
          && wondersRoom(code).status == 'playing'
          && hasExactly(request.resource.data, ['n', 'by', 'move'])
          && (request.resource.data.by == request.auth.uid
            || (request.resource.data.by in botIds() && request.resource.data.by in wondersRoom(code).seats
              && request.auth.uid == wondersRoom(code).host))
          && request.resource.data.n is int && request.resource.data.n >= 0
          && string(request.resource.data.n) == n
          && (request.resource.data.n == 0
            || exists(/databases/$(database)/documents/wonders/$(code)/moves/$(string(request.resource.data.n - 1))))
          && request.resource.data.move is map;
      }
    }

    function isWondersJoin() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby'
        && !(request.auth.uid in before.seats)
        && before.seats.size() < 7
        && after.diff(before).affectedKeys().hasOnly(['seats', 'names'])
        && after.seats == before.seats.concat([request.auth.uid])
        && after.names.diff(before.names).affectedKeys().hasOnly([request.auth.uid])
        && isValidName(after.names[request.auth.uid]);
    }

    function isWondersLeave() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby'
        && request.auth.uid in before.seats && request.auth.uid != before.host
        && after.diff(before).affectedKeys().hasOnly(['seats'])
        && after.seats == before.seats.removeAll([request.auth.uid]);
    }

    // The host's lobby controls: the wonder sides, adding and removing bots, and the
    // seating order. No person can be added or removed this way.
    function isWondersSetup() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby' && request.auth.uid == before.host
        && after.diff(before).affectedKeys().hasOnly(['seats', 'names', 'sides'])
        && after.sides in ['A', 'B', 'random']
        && after.seats.size() >= 1 && after.seats.size() <= 7
        && after.seats.toSet().size() == after.seats.size()
        && after.seats.toSet().difference(before.seats.toSet()).hasOnly(botIds())
        && before.seats.toSet().difference(after.seats.toSet()).hasOnly(botIds())
        && after.names.diff(before.names).affectedKeys().hasOnly(botIds());
    }

    function isWondersStart() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby' && request.auth.uid == before.host
        && before.seats.size() >= 3 && before.seats.size() <= 7
        && after.diff(before).affectedKeys().hasOnly(['status', 'seed', 'startedAt'])
        && after.status == 'playing'
        && after.seed is string && after.seed.size() >= 6 && after.seed.size() <= 40
        && after.startedAt == request.time;
    }

    function isWondersFinish() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'playing' && request.auth.uid in before.seats
        && after.diff(before).affectedKeys().hasOnly(['status', 'endedAt'])
        && after.status == 'done'
        && after.endedAt == request.time;
    }

    // ---------- Island Settlers ----------
    // 3–4 seats, bots as in Ancient Wonders. The seed decides the island, the dice and
    // the steals; every move is appended in order, by its own player or, for a bot, the
    // host. As there, the rules can't judge a move: every phone replays them and skips
    // any the game refuses.

    function isleRoom(code) {
      return get(/databases/$(database)/documents/isles/$(code)).data;
    }

    function isIslePlayer(code) {
      return request.auth != null && request.auth.uid in isleRoom(code).seats;
    }

    match /isles/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && code.matches('[A-Z]{4}')
        && hasExactly(request.resource.data, ['host', 'seats', 'names', 'status', 'createdAt'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.seats == [request.auth.uid]
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && isValidName(request.resource.data.names[request.auth.uid])
        && request.resource.data.status == 'lobby'
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && (isIsleJoin() || isIsleLeave() || isIsleSetup() || isIsleStart() || isIsleFinish());

      match /moves/{n} {
        allow read: if isIslePlayer(code);
        allow create: if isIslePlayer(code)
          && isleRoom(code).status == 'playing'
          && hasExactly(request.resource.data, ['n', 'by', 'move'])
          && (request.resource.data.by == request.auth.uid
            || (request.resource.data.by in botIds() && request.resource.data.by in isleRoom(code).seats
              && request.auth.uid == isleRoom(code).host))
          && request.resource.data.n is int && request.resource.data.n >= 0
          && string(request.resource.data.n) == n
          && (request.resource.data.n == 0
            || exists(/databases/$(database)/documents/isles/$(code)/moves/$(string(request.resource.data.n - 1))))
          && request.resource.data.move is map;
      }
    }

    function isIsleJoin() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby'
        && !(request.auth.uid in before.seats)
        && before.seats.size() < 4
        && after.diff(before).affectedKeys().hasOnly(['seats', 'names'])
        && after.seats == before.seats.concat([request.auth.uid])
        && after.names.diff(before.names).affectedKeys().hasOnly([request.auth.uid])
        && isValidName(after.names[request.auth.uid]);
    }

    function isIsleLeave() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby'
        && request.auth.uid in before.seats && request.auth.uid != before.host
        && after.diff(before).affectedKeys().hasOnly(['seats'])
        && after.seats == before.seats.removeAll([request.auth.uid]);
    }

    // The host's lobby controls: adding and removing bots, and the seating order.
    function isIsleSetup() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby' && request.auth.uid == before.host
        && after.diff(before).affectedKeys().hasOnly(['seats', 'names'])
        && after.seats.size() >= 1 && after.seats.size() <= 4
        && after.seats.toSet().size() == after.seats.size()
        && after.seats.toSet().difference(before.seats.toSet()).hasOnly(botIds())
        && before.seats.toSet().difference(after.seats.toSet()).hasOnly(botIds())
        && after.names.diff(before.names).affectedKeys().hasOnly(botIds());
    }

    function isIsleStart() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby' && request.auth.uid == before.host
        && before.seats.size() >= 3 && before.seats.size() <= 4
        && after.diff(before).affectedKeys().hasOnly(['status', 'seed', 'startedAt'])
        && after.status == 'playing'
        && after.seed is string && after.seed.size() >= 6 && after.seed.size() <= 40
        && after.startedAt == request.time;
    }

    function isIsleFinish() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'playing' && request.auth.uid in before.seats
        && after.diff(before).affectedKeys().hasOnly(['status', 'endedAt'])
        && after.status == 'done'
        && after.endedAt == request.time;
    }

    // ---------- Sky Brawl online ----------
    // Two phones fight each other directly over WebRTC. Firestore holds only the room
    // (who's in, the seed) and one handshake each way: the host's offer
    // and the guest's answer, one document each per attempt (offer, offer-1, ...). The
    // fight itself never touches Firestore, so there's nothing in it for the rules to check.

    function brawl(code) {
      return get(/databases/$(database)/documents/brawls/$(code)).data;
    }

    match /brawls/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && code.matches('[A-Z]{4}')
        && hasExactly(request.resource.data, ['host', 'playerIds', 'names', 'status', 'createdAt'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.playerIds == [request.auth.uid]
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && isValidName(request.resource.data.names[request.auth.uid])
        && request.resource.data.status == 'lobby'
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && (isBrawlJoin() || isBrawlStart() || isBrawlFinish());

      match /signals/{id} {
        allow read: if request.auth != null && request.auth.uid in brawl(code).playerIds;
        allow create: if request.auth != null
          && id.matches('(offer|answer)(-[0-9])?')
          && brawl(code).status == 'playing'
          && hasExactly(request.resource.data, ['sdp', 'at'])
          && request.resource.data.sdp is string
          && request.resource.data.sdp.size() > 0 && request.resource.data.sdp.size() <= 20000
          && request.resource.data.at == request.time
          && (isBrawlOffer(code, id) || isBrawlAnswer(code, id));
      }
    }

    function isBrawlOffer(code, id) {
      return id.matches('offer(-[0-9])?') && request.auth.uid == brawl(code).host;
    }

    // Only the guest answers, and only an offer that's there.
    function isBrawlAnswer(code, id) {
      return id.matches('answer(-[0-9])?')
        && brawl(code).playerIds.size() == 2
        && request.auth.uid == brawl(code).playerIds[1]
        && exists(/databases/$(database)/documents/brawls/$(code)/signals/$(id.replace('answer', 'offer')));
    }

    function isBrawlJoin() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby'
        && before.playerIds.size() == 1
        && !(request.auth.uid in before.playerIds)
        && after.diff(before).affectedKeys().hasOnly(['playerIds', 'names'])
        && after.playerIds == before.playerIds.concat([request.auth.uid])
        && after.names.diff(before.names).affectedKeys().hasOnly([request.auth.uid])
        && isValidName(after.names[request.auth.uid]);
    }

    function isBrawlStart() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'lobby' && request.auth.uid == before.host
        && before.playerIds.size() == 2
        && after.diff(before).affectedKeys().hasOnly(['status', 'seed', 'startedAt', 'rules'])
        && after.status == 'playing'
        && after.seed is string && after.seed.size() >= 6 && after.seed.size() <= 40
        && (!('rules' in after) || isBrawlRules(after.rules))
        && after.startedAt == request.time;
    }

    // How the fight is won: rounds to 3, 5, 7 or 10 points, or 3 to 5 minutes timed.
    function isBrawlRules(rules) {
      return rules is map && rules.keys().hasAll(['mode', 'value']) && rules.keys().hasOnly(['mode', 'value'])
        && ((rules.mode == 'score' && rules.value in [3, 5, 7, 10])
          || (rules.mode == 'timed' && rules.value in [3, 4, 5]));
    }

    function isBrawlFinish() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'playing' && request.auth.uid in before.playerIds
        && after.diff(before).affectedKeys().hasOnly(['status', 'endedAt'])
        && after.status == 'done'
        && after.endedAt == request.time;
    }
  }
}
